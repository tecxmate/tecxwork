<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job: run the TECXWORK backup hourly.

  Install:
    cp scripts/com.tecxwork.backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.tecxwork.backup.plist

  Run once immediately to test:
    launchctl start com.tecxwork.backup

  Stop / uninstall:
    launchctl unload ~/Library/LaunchAgents/com.tecxwork.backup.plist

  Logs: ~/tecxwork-backups/launchd.out.log and launchd.err.log
        (the script also logs each run to ~/tecxwork-backups/backup.log if you tee it)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tecxwork.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/niko/antigravity/tecxwork/scripts/backup.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/niko/antigravity/tecxwork</string>

    <!-- Run hourly. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Also run once as soon as the job is loaded. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/niko/tecxwork-backups/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/niko/tecxwork-backups/launchd.err.log</string>
</dict>
</plist>
